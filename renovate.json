{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)helmrelease\\.yaml$/"
    ]
  },
  "timezone": "Asia/Jerusalem",
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "automergeSchedule": [
    "* 4-6 * * 6"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "description": "Routine lane: non-major updates automerge in the Saturday 04:00 window after required checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "labels": [
        "risk/routine"
      ]
    },
    {
      "description": "Review lane: every major update needs a human click in server-hub",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "risk/review"
      ]
    },
    {
      "description": "Review lane: stateful, migration-prone or financial apps, regardless of semver (charts can hide app majors)",
      "matchPackageNames": [
        "authentik",
        "/homarr/",
        "/vaultwarden/",
        "/tracearr/",
        "redis",
        "/timescaledb/",
        "/immich/",
        "/n8n/",
        "/jellyfin/",
        "/seerr/",
        "/jellyseerr/",
        "/moneyman/",
        "/splitwise-ynab-sync/",
        "longhorn"
      ],
      "automerge": false,
      "labels": [
        "risk/review"
      ]
    },
    {
      "description": "Platform lane: cluster version, GitOps engine, networking and CRD-bearing charts",
      "matchPackageNames": [
        "rancher/k3s-upgrade",
        "/fluxcd/",
        "flux2",
        "cilium",
        "cert-manager",
        "external-secrets",
        "kube-prometheus-stack",
        "intel/intel-gpu-plugin",
        "/external-dns/",
        "/system-upgrade-controller/"
      ],
      "automerge": false,
      "labels": [
        "risk/platform"
      ]
    },
    {
      "description": "Platform lane: Kubernetes apiVersion migrations change how controllers read objects",
      "matchDatasources": [
        "kubernetes-api"
      ],
      "automerge": false,
      "labels": [
        "risk/platform"
      ]
    },
    {
      "description": "Keep kubectl within +/-1 minor of the API server (cluster on 1.36)",
      "matchDepNames": [
        "kubectl"
      ],
      "allowedVersions": "<1.37.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)helmrelease\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "CRDS_CATALOG_REF = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "https://github.com/datreeio/CRDs-catalog",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.yaml$/",
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[\\s\\S]*?--package \\S+@(?<currentValue>[0-9][^\\s]*)"
      ]
    }
  ]
}
