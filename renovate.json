{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)helmrelease\\.yaml$/"
    ]
  },
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "description": "Routine: non-major updates. server-hub merges these in the maintenance window unless the workload holding the image is annotated homelab.dev/upgrade: manual",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "labels": [
        "risk/routine"
      ]
    },
    {
      "description": "Review: every major update",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "risk/review"
      ]
    },
    {
      "description": "Review: Helm charts (can hide app majors and ship CRDs)",
      "matchDatasources": [
        "helm"
      ],
      "labels": [
        "risk/review"
      ]
    },
    {
      "description": "Platform: cluster-level manifests (k3s, Flux, CNI, controllers)",
      "matchFileNames": [
        "clusters/**",
        "controllers/**",
        "infrastructure/**"
      ],
      "labels": [
        "risk/platform"
      ]
    },
    {
      "description": "Platform: Kubernetes apiVersion migrations",
      "matchDatasources": [
        "kubernetes-api"
      ],
      "labels": [
        "risk/platform"
      ]
    },
    {
      "description": "Keep kubectl within +/-1 minor of the API server (cluster on 1.36)",
      "matchDepNames": [
        "kubectl"
      ],
      "allowedVersions": "<1.37.0"
    },
    {
      "description": "hotio images tag releases as release-X.Y.Z",
      "matchPackageNames": [
        "/^ghcr\\.io\\/hotio\\//"
      ],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "k3s: plan version and image land together in one draft PR (draft = held until server-hub's preflighted upgrade)",
      "matchDepNames": [
        "rancher/k3s-upgrade"
      ],
      "groupName": "k3s",
      "draftPR": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)helmrelease\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "CRDS_CATALOG_REF = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "https://github.com/datreeio/CRDs-catalog",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.yaml$/",
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[\\s\\S]*?--package \\S+@(?<currentValue>[0-9][^\\s]*)"
      ]
    },
    {
      "customType": "regex",
      "description": "SUC Plan version: only a version change triggers upgrade Jobs, so it must move with the image",
      "managerFilePatterns": [
        "/^controllers/production/system-upgrade-controller/.+-plan\\.yaml$/"
      ],
      "matchStrings": [
        "\\n  version: (?<currentValue>v\\d+\\.\\d+\\.\\d+-k3s\\d+)\\n"
      ],
      "depNameTemplate": "rancher/k3s-upgrade",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
