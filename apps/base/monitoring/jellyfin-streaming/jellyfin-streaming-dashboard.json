    {
      "type": "timeseries",
      "title": "Probe HTTP status by device",
      "description": "Expected: 200 for xbox/androidtv/webos, 403 for desktop_blocked, 302 for watch_access.",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (device) (last_over_time(probe_http_status_code{job=\"jellyfin-device-access\"}[35m]))",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
