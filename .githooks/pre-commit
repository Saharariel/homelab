#!/usr/bin/env bash

set -euo pipefail

root="$(git rev-parse --show-toplevel)"

# shellcheck source=scripts/resolve-mise.sh
. "${root}/scripts/resolve-mise.sh"

if ! mise_bin="$(resolve_mise)"; then
  echo "pre-commit: mise is not installed, refusing to commit." >&2
  echo "pre-commit: install it from https://mise.jdx.dev, or commit with --no-verify." >&2
  exit 1
fi

exec "${mise_bin}" run scan-staged
